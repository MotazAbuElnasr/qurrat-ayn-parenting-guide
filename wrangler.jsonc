{
  // account id comes from CLOUDFLARE_ACCOUNT_ID / the API token — the repo is public
  "name": "qurrat-ain",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "./docs", "binding": "ASSETS", "run_worker_first": ["/api/*", "/*.mp4"] },
  "routes": [{ "pattern": "qurrat-ain.aro.day", "custom_domain": true }],
  "observability": { "enabled": true },
  // per-IP burst limits, checked before any D1 query runs
  "unsafe": {
    "bindings": [
      { "name": "RL_READ", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 90, "period": 60 } },
      { "name": "RL_WRITE", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qurrat-ain-community",
      "database_id": "2ee937d6-4f83-4775-8d6e-7a0f4c2e8abe"
    }
  ]
}
