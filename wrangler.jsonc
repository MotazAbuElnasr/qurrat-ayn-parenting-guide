{
  // account id comes from CLOUDFLARE_ACCOUNT_ID / the API token — the repo is public
  "name": "qurrat-ain",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-01",
  // a tab is a real path now (/values, /sits), so a cold load on one has to get index.html back
  // /v/* and /s/* are rendered per item and /sitemap.xml is generated from the
  // bundle, so the worker has to see them — single-page-application handling
  // would otherwise answer all four with the shell and a 200.
  "assets": { "directory": "./docs", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/*.mp4", "/v/*", "/s/*", "/m/*", "/a/*", "/sitemap.xml", "/llms.txt", "/values", "/sits", "/ref", "/vids", "/day", "/acts", "/food", "/comm", "/partners", "/res"] },
  "routes": [{ "pattern": "qurrat-ain.aro.day", "custom_domain": true }],
  "observability": { "enabled": true },
  // per-IP burst limits, checked before any D1 query runs
  "unsafe": {
    "bindings": [
      { "name": "RL_READ", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 90, "period": 60 } },
      { "name": "RL_WRITE", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qurrat-ain-community",
      "database_id": "2ee937d6-4f83-4775-8d6e-7a0f4c2e8abe"
    }
  ]
}
